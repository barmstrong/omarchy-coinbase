{
  "name": "omarchy-oauth",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "SESSIONS"
    }
  ],
  "ratelimits": [
    {
      "name": "OAUTH_START_LIMITER",
      "namespace_id": "63841001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "OAUTH_TOKEN_LIMITER",
      "namespace_id": "63841002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "OAUTH_SESSION_LIMITER",
      "namespace_id": "63841003",
      "simple": {
        "limit": 240,
        "period": 60
      }
    }
  ]
}
